# Create at https://my.telegram.org/apps (not BotFather).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# BotFather token used by TolaAI. Never commit the real value.
TELEGRAM_BOT_TOKEN=

# Generate with: openssl rand -hex 32
APP_API_TOKEN=

# Exact trusted S3/download hosts. Wildcards match subdomains only.
# For local MinIO also set SOURCE_ALLOW_HTTP=true.
SOURCE_ALLOWED_HOSTS=storage.yandexcloud.net,*.twcstorage.ru
SOURCE_ALLOW_HTTP=false

# Official local Bot API upload maximum is 2000 MB.
DELIVERY_MAX_FILE_BYTES=2000000000
DELIVERY_MAX_ATTEMPTS=4
DELIVERY_WORKER_CONCURRENCY=2
DELIVERY_JOB_TTL_SECONDS=604800
# Readiness Redis checks must fail before the external health probe times out.
REDIS_HEALTH_TIMEOUT_SECONDS=3
# Must exceed the 5-second blocking queue wait used by the worker.
REDIS_WORKER_SOCKET_TIMEOUT_SECONDS=15
# Hard wall-clock limit for one S3 download, including slow trickle responses.
SOURCE_TOTAL_TIMEOUT_SECONDS=7200
# Readiness must never inherit the two-hour upload timeout.
TELEGRAM_HEALTH_TIMEOUT_SECONDS=5

DELIVERY_API_PORT=8080
TELEGRAM_BOT_API_PORT=8081
TELEGRAM_DOCKER_NETWORK=tola-telegram
LOG_LEVEL=INFO
# Safe deployment label (Git SHA or release tag) included in diagnostic logs.
APP_RELEASE=development

# Pinned upstream commit. Review and update deliberately.
TELEGRAM_BOT_API_COMMIT=e3e9dd8e5b3d7ab8537cd5a10dc31d5ffa8f82d1
